# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT & Admin Session Secret
# REQUIRED. Generate a unique value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=change-me-generate-a-unique-64-char-secret

# Default Super Admin Seed Credentials (used only when the data store is first created)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-before-first-run

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
